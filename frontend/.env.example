# IntelliJudge — Frontend Environment Variables
# Copy to .env.local and fill in your values:
#   cp .env.example .env.local

# URL of your running FastAPI backend (include /api at the end)
# Local dev:
NEXT_PUBLIC_API_URL=http://localhost:8000/api
# Production (set this in Vercel project settings):
# NEXT_PUBLIC_API_URL=https://your-railway-backend.railway.app/api
